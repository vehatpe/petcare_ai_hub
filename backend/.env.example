# --- SQL Server ---
DB_SERVER=localhost
DB_NAME=PetCareAIHub
DB_USER=sa
DB_PASSWORD=123456
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true      # true only for local dev with a self-signed certificate

# --- Auth ---
# Production requires >= 32 random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Gemini (REST, no SDK) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- RAG ---
RAG_TOP_K=4
RAG_MIN_SCORE=0.6
# Môi trường dev mặc định là false (cho phép thử nghiệm tài liệu nháp).
# KHUYẾN NGHỊ CHO PRODUCTION: RAG_REQUIRE_APPROVED=true (chỉ sử dụng các chunk tri thức đã được bác sĩ thú y duyệt qua trạng thái 'approved').
RAG_REQUIRE_APPROVED=false

# --- Rate Limit (Giới hạn tốc độ) ---
# RATE_LIMIT_WINDOW_MS=900000   # Cửa sổ thời gian (15 phút = 900.000 ms)
# AUTH_RATE_LIMIT_MAX=15        # Số lần tối đa cho register và login (khóa theo IP + identifier)
# ME_RATE_LIMIT_MAX=300         # Hạn mức rộng cho /auth/me (300 lượt / 15 phút)
# AI_RATE_LIMIT_MAX=20          # Giới hạn gọi AI chat (khóa theo user ID, chống lạm dụng API key)

# --- Server ---
PORT=3000
CORS_ORIGIN=                   # comma separated origins; empty = no CORS (same-origin)
SERVE_FRONTEND=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
# NODE_ENV=production
# TRUST_PROXY: BẮT BUỘC đặt khi triển khai sau reverse proxy (Nginx, Cloudflare, AWS ALB, Caddy, ...).
# Nếu không đặt, req.ip sẽ là địa chỉ IP nội bộ của reverse proxy, khiến tất cả người dùng dùng chung một IP
# dẫn tới việc rate limit bị kích hoạt oan (429 rate_limited) cho toàn bộ người dùng.
# Giá trị: 1 (1 hop proxy), hoặc true, hoặc 'loopback, linklocal, uniquelocal'.
# TRUST_PROXY=1
