# --- SQL Server ---
DB_SERVER=localhost
DB_NAME=PetCareAIHub
DB_USER=sa
DB_PASSWORD=123456
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true      # true only for local dev with a self-signed certificate

# --- Auth ---
# Production requires >= 32 random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Gemini (REST, no SDK) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- RAG ---
RAG_TOP_K=4
RAG_MIN_SCORE=0.6
# Môi trường dev mặc định là false (cho phép thử nghiệm tài liệu nháp).
# KHUYẾN NGHỊ CHO PRODUCTION: RAG_REQUIRE_APPROVED=true (chỉ sử dụng các chunk tri thức đã được bác sĩ thú y duyệt qua trạng thái 'approved').
RAG_REQUIRE_APPROVED=false

# --- Rate Limit (Giới hạn tốc độ) ---
# RATE_LIMIT_WINDOW_MS=900000   # Cửa sổ thời gian (15 phút = 900.000 ms)
# AUTH_RATE_LIMIT_MAX=15        # Số lần tối đa cho register và login (khóa theo IP + identifier)
# ME_RATE_LIMIT_MAX=300         # Hạn mức rộng cho /auth/me (300 lượt / 15 phút)
# AI_RATE_LIMIT_MAX=20          # Giới hạn gọi AI chat (khóa theo user ID, chống lạm dụng API key)
# UPLOAD_RATE_LIMIT_MAX=30      # Giới hạn tải ảnh lên (khóa theo user ID)

# --- Lưu trữ ảnh (Storage) ---
# STORAGE_DRIVER: 'local' (mặc định dev/CI) hoặc 'cloudinary' (KHUYẾN NGHỊ PRODUCTION vì đĩa của nhiều nền tảng triển khai là tạm thời)
STORAGE_DRIVER=local
# UPLOAD_DIR=                   # Thư mục lưu ảnh khi STORAGE_DRIVER=local (mặc định backend/uploads)
# UPLOAD_MAX_BYTES=5242880      # Dung lượng ảnh tối đa tính bằng byte (mặc định 5 MB, từ 1024 đến 20971520)
# PUBLIC_BASE_URL: Tùy chọn dựng URL tuyệt đối cho driver 'local' (trống -> /uploads/...).
# Lưu ý dev: nếu dùng Live Server cổng 5500/5501, PHẢI đặt PUBLIC_BASE_URL=http://localhost:3000 thì ảnh local mới hiển thị.
# PUBLIC_BASE_URL=
# Bắt buộc CHỈ khi STORAGE_DRIVER=cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Server ---
PORT=3000
CORS_ORIGIN=                   # comma separated origins; empty = dev: Live Server 5500/5501 allowed, production: no CORS
SERVE_FRONTEND=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
BOOKING_CANCEL_WINDOW_HOURS=2  # Thời gian tối thiểu (giờ) trước khung hẹn cho phép chủ nuôi hủy lịch (mặc định 2, từ 0 đến 72)
# NODE_ENV=production
# TRUST_PROXY: BẮT BUỘC đặt khi triển khai sau reverse proxy (Nginx, Cloudflare, AWS ALB, Caddy, ...).
# Nếu không đặt, req.ip sẽ là địa chỉ IP nội bộ của reverse proxy, khiến tất cả người dùng dùng chung một IP
# dẫn tới việc rate limit bị kích hoạt oan (429 rate_limited) cho toàn bộ người dùng.
# Giá trị: 1 (1 hop proxy), hoặc true, hoặc 'loopback, linklocal, uniquelocal'.
# TRUST_PROXY=1
